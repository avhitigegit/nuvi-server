# Copy this file to .env and fill in your real values.
# .env is in .gitignore and must NEVER be committed.

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# ─── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ─── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY=your-iam-access-key
AWS_SECRET_KEY=your-iam-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name

# ─── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Production only: comma-separated allowed frontend domains
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# ─── Spring Profile ────────────────────────────────────────────────────────────
# Set to "prod" on your server to enforce HTTPS and disable Swagger
# Leave empty or "dev" for local development
SPRING_PROFILES_ACTIVE=dev
